msgstr "Vizsgálat"

#: includes/Admin/SettingsPage.php:118
msgid "The LW Scan admin interface is missing (build/index.js). Reinstall the plugin from a release package, or run \"npm run build\" in a development checkout."
msgstr "Hiányzik az LW Scan admin felülete (build/index.js). Telepítsd újra a bővítményt egy release csomagból, vagy futtasd az „npm run build” parancsot egy fejlesztői checkoutban."

#: includes/Health/Checks/BackendCheck.php:29
msgid "Signature backend"
msgstr "Szignatúra-backend"

#: includes/Health/Checks/BackendCheck.php:38
msgid "The signature backend has not been checked yet."
msgstr "A szignatúra-backend még nincs ellenőrizve."

#. translators: %s: human-readable time difference, e.g. "2 hours".
#: includes/Health/Checks/BackendCheck.php:46
#, php-format
msgid "Last checked %s ago."
msgstr "Utoljára ellenőrizve %s ezelőtt."

#: includes/Health/Checks/BundleCheck.php:51 build/index.js:17
msgid "Signature bundle"
msgstr "Szignatúracsomag"

#: includes/Health/Checks/BundleCheck.php:58
msgid "No signature pack yet — the first scan downloads it."
msgstr "Még nincs szignatúracsomag — az első vizsgálat letölti."

#. translators: %d: signature pack version.
#: includes/Health/Checks/BundleCheck.php:63
#, php-format
msgid "The files of signature pack v%d are missing — the next scan downloads them again."
msgstr "Hiányoznak a v%d szignatúracsomag fájljai — a következő vizsgálat újra letölti őket."

#. translators: 1: signature pack version. 2: number of signatures.
#: includes/Health/Checks/BundleCheck.php:69
#, php-format
msgid "Signature pack v%1$d, %2$s signature."
msgid_plural "Signature pack v%1$d, %2$s signatures."
msgstr[0] "v%1$d szignatúracsomag, %2$s szignatúra."
msgstr[1] "v%1$d szignatúracsomag, %2$s szignatúra."

#: includes/Health/Checks/CronCheck.php:39
msgid "WP-Cron"
msgstr "WP-Cron"

#: includes/Health/Checks/CronCheck.php:49
msgid "DISABLE_WP_CRON is set — a system cron runner is expected to trigger scheduled scans."
msgstr "A DISABLE_WP_CRON be van állítva — az ütemezett vizsgálatokat egy rendszer cronnak kell indítania."

#: includes/Health/Checks/CronCheck.php:50
msgid "Built-in WP-Cron (triggered by site visits)."
msgstr "Beépített WP-Cron (az oldal látogatásai indítják)."

#: includes/Health/Checks/CronCheck.php:68
msgid "The server can reach its own site for WP-Cron."
msgstr "A szerver eléri a saját oldalát a WP-Cronhoz."

#: includes/Health/Checks/CronCheck.php:69
msgid "The server cannot reach its own site — scheduled scans only progress via site traffic, WP-CLI, or a system cron runner."
msgstr "A szerver nem éri el a saját oldalát — az ütemezett vizsgálatok csak látogatói forgalom, WP-CLI vagy rendszer cron révén haladnak."

#: includes/Health/Checks/MemoryCheck.php:68
msgid "Memory & time budget"
msgstr "Memória- és időkeret"

#. translators: %s: per-tick time budget in seconds.
#: includes/Health/Checks/MemoryCheck.php:78
#, php-format
msgid "memory_limit is unlimited; per-tick time budget %ss."
msgstr "a memory_limit korlátlan; lépésenkénti időkeret: %ss."

#. translators: %s: memory_limit ini value, e.g. "64M".
#: includes/Health/Checks/MemoryCheck.php:88
#, php-format
msgid "memory_limit is %s — scans need at least 128 MB."
msgstr "a memory_limit %s — a vizsgálatokhoz legalább 128 MB kell."

#. translators: 1: memory in use. 2: memory_limit. 3: memory left for a tick.
#: includes/Health/Checks/MemoryCheck.php:118
#, php-format
msgid "WordPress and your plugins already use %1$s of the %2$s memory_limit, leaving %3$s; a scan tick needs about 20 MB. Raise memory_limit or run scans with WP-CLI."
msgstr "A WordPress és a bővítményeid már %1$s memóriát használnak a %2$s memory_limitből, így %3$s marad; egy vizsgálati lépéshez kb. 20 MB kell. Emeld a memory_limitet, vagy futtasd a vizsgálatot WP-CLI-vel."

#. translators: 1: memory_limit. 2: memory free after WordPress loads. 3: per-tick time budget in seconds.
#: includes/Health/Checks/MemoryCheck.php:130
#, php-format
msgid "memory_limit %1$s, %2$s free after WordPress loads; per-tick time budget %3$ss."
msgstr "memory_limit %1$s, a WordPress betöltése után %2$s szabad; lépésenkénti időkeret: %3$ss."

#: includes/Health/Checks/PcreCheck.php:44
msgid "PCRE engine"
msgstr "PCRE motor"

#: includes/Health/Checks/PcreCheck.php:54
msgid "The host does not allow raising pcre.backtrack_limit/pcre.recursion_limit — very large files may silently fail to match."
msgstr "A tárhely nem engedi a pcre.backtrack_limit/pcre.recursion_limit emelését — a nagyon nagy fájloknál a találat csendben elmaradhat."

#: includes/Health/Checks/PcreCheck.php:62
msgid "PCRE JIT is disabled — regex matching will be slower on large sites."
msgstr "A PCRE JIT ki van kapcsolva — a regex-illesztés nagy oldalakon lassabb lesz."

#: includes/Health/Checks/PcreCheck.php:69
msgid "PCRE limits tuned and JIT enabled."
msgstr "PCRE limitek beállítva, JIT bekapcsolva."

#: includes/Health/Checks/StorageCheck.php:40
msgid "Storage directory"
msgstr "Tárolási könyvtár"

#. translators: %s: absolute storage directory path.
#: includes/Health/Checks/StorageCheck.php:50
#, php-format
msgid "%s is not writable — the signature bundle cannot be stored and scans cannot start."
msgstr "%s nem írható — a szignatúracsomag nem tárolható, és vizsgálat nem indulhat."

#. translators: 1: absolute storage directory path. 2: human-readable size, e.g. "4 MB".
#: includes/Health/Checks/StorageCheck.php:58
#, php-format
msgid "%1$s is writable, guard files in place (%2$s used)."
msgstr "%1$s írható, a védőfájlok a helyükön (%2$s használatban)."

#: includes/Health/Checks/TablesCheck.php:37
msgid "Database tables"
msgstr "Adatbázistáblák"

#. translators: %s: comma-separated list of missing table names.
#: includes/Health/Checks/TablesCheck.php:48
#, php-format
msgid "The plugin's database tables are missing (%s) — deactivate and reactivate the plugin."
msgstr "Hiányoznak a bővítmény adatbázistáblái (%s) — kapcsold ki, majd kapcsold be újra a bővítményt."

#. translators: 1: table name. 2: row count.
#: includes/Health/Checks/TablesCheck.php:81
#, php-format
msgid "%1$s (%2$s rows)"
msgstr "%1$s (%2$s sor)"

#: includes/Health/Checks/TablesCheck.php:89
msgid "all InnoDB"
msgstr "mind InnoDB"

#. translators: %s: comma-separated list of "table (engine)".
#: includes/Health/Checks/TablesCheck.php:91
#, php-format
msgid "not InnoDB: %s"
msgstr "nem InnoDB: %s"

#: includes/Health/Checks/TokenizerCheck.php:27
msgid "Tokenizer extension"
msgstr "Tokenizer bővítmény (PHP)"

#: includes/Health/Checks/TokenizerCheck.php:34
msgid "The tokenizer extension is not available — the heuristic layer is disabled."
msgstr "A tokenizer PHP-bővítmény nem érhető el — a heurisztikus réteg ki van kapcsolva."

#: includes/Health/Checks/TokenizerCheck.php:41
msgid "Tokenizer extension available."
msgstr "A tokenizer PHP-bővítmény elérhető."

#: includes/HelloPack/StatusCheck.php:99 includes/SiteManager/Abilities.php:64
msgid "Malware scan"
msgstr "Kártevő-vizsgálat"

#: includes/HelloPack/StatusCheck.php:103
msgid "New alerts from the last scan, and whether scans still run on schedule."
msgstr "Új riasztások az utolsó vizsgálatból, és hogy a vizsgálatok továbbra is ütemezetten futnak-e."

#: includes/HelloPack/StatusCheck.php:178 build/index.js:6 build/index.js:13
msgid "No scan has run yet."
msgstr "Még nem futott le vizsgálat."

#. translators: %d: number of new alert-severity findings.
#: includes/HelloPack/StatusCheck.php:222
#, php-format
msgid "%d new alert."
msgid_plural "%d new alerts."
msgstr[0] "%d új riasztás."
msgstr[1] "%d új riasztás."

#: includes/HelloPack/StatusCheck.php:237
msgid "The last scan failed."
msgstr "Az utolsó vizsgálat sikertelen volt."

#: includes/HelloPack/StatusCheck.php:241
msgid "No scan has completed successfully yet."
msgstr "Még nem fejeződött be sikeresen vizsgálat."

#: includes/HelloPack/StatusCheck.php:247
msgid "No successful scan in the last two scheduled windows."
msgstr "Az utolsó két ütemezett időablakban nem volt sikeres vizsgálat."

#. translators: %s: human-readable time span, e.g. "11 minutes".
#: includes/HelloPack/StatusCheck.php:262
#, php-format
msgid "Last scan clean, %s ago."
msgstr "Az utolsó vizsgálat tiszta volt (%s ezelőtt)."

#. translators: %d: number of new alert-level findings.
#: includes/Notify/AdminNotice.php:53
#, php-format
msgid "%d new alert found by LW Scan."
msgid_plural "%d new alerts found by LW Scan."
msgstr[0] "%d új riasztást talált az LW Scan."
msgstr[1] "%d új riasztást talált az LW Scan."

#: includes/Notify/AdminNotice.php:58
msgid "This was the first scan, so these are a baseline of what is already on the site — no e-mail was sent. Later scans report only what is new."
msgstr "Ez volt az első vizsgálat, ezért ezek az oldalon már meglévő állapot kiindulópontját adják — e-mail nem ment ki. A későbbi vizsgálatok csak az újdonságokat jelentik."

#: includes/Notify/AdminNotice.php:65
msgid "Review findings"
msgstr "Találatok áttekintése"

#. translators: %s: site name.
#: includes/Notify/Mailer.php:103
#, php-format
msgid "[%s] LW Scan: scheduled scans are failing"
msgstr "[%s] LW Scan: az ütemezett vizsgálatok sikertelenek"

#. translators: %s: site name.
#: includes/Notify/Mailer.php:136
#, php-format
msgid "[%s] LW Scan: test e-mail"
msgstr "[%s] LW Scan: teszt e-mail"

#: includes/Notify/Mailer.php:140
msgid "This is a test e-mail from LW Scan. Notification e-mails reach this address."
msgstr "Ez egy teszt e-mail az LW Scantől. Az értesítő e-mailek erre a címre érkeznek."

#. translators: %d: number of new findings the e-mail did not list.
#: includes/Notify/Mailer.php:162
#, php-format
msgid "… and %d more — see the Findings tab"
msgstr "… és még %d — lásd a Találatok fület"

#. translators: 1: site name. 2: number of new findings.
#: includes/Notify/Mailer.php:266
#, php-format
msgid "[%1$s] LW Scan: %2$d new finding"
msgid_plural "[%1$s] LW Scan: %2$d new findings"
msgstr[0] "[%1$s] LW Scan: %2$d új találat"
msgstr[1] "[%1$s] LW Scan: %2$d új találat"

#. translators: 1: site name. 2: number of new alerts.
#: includes/Notify/Mailer.php:274
#, php-format
msgid "[%1$s] LW Scan: %2$d new alert"
msgid_plural "[%1$s] LW Scan: %2$d new alerts"
msgstr[0] "[%1$s] LW Scan: %2$d új riasztás"
msgstr[1] "[%1$s] LW Scan: %2$d új riasztás"

#: includes/Rest/Errors.php:41
msgid "A scan is in progress. Stop it or wait until it finishes, then try again."
msgstr "Egy vizsgálat folyamatban van. Állítsd le, vagy várd meg, amíg befejeződik, majd próbáld újra."

#: includes/Rest/FindingsController.php:96 includes/SiteManager/AbilityCallbacks.php:116
msgid "Unknown finding state."
msgstr "Ismeretlen találatállapot."

#: includes/Rest/HealthController.php:97
msgid "Unknown bundle operation."
msgstr "Ismeretlen csomagművelet."

#: includes/Rest/HealthController.php:119
msgid "Unknown index operation."
msgstr "Ismeretlen indexművelet."

#: includes/Rest/Presenter/FindingPresenter.php:88
msgid "Remove or restore the file. LW Scan never deletes files itself."
msgstr "Távolítsd el vagy állítsd vissza a fájlt. Az LW Scan soha nem töröl fájlt magától."

#: includes/Rest/Presenter/FindingPresenter.php:90
msgid "Inspect and clean the row in the database (e.g. via WP-CLI or phpMyAdmin)."
msgstr "Vizsgáld meg és tisztítsd meg az adatbázisban lévő sort (pl. WP-CLI-vel vagy phpMyAdminnal)."

#: includes/Rest/Presenter/FindingPresenter.php:131
msgid "Re-install the affected package from wordpress.org to restore the original file."
msgstr "Telepítsd újra az érintett csomagot a wordpress.org-ról az eredeti fájl visszaállításához."

#. translators: 1: package name, e.g. WordPress or a plugin slug. 2: package version.
#: includes/Rest/Presenter/FindingPresenter.php:136
#, php-format
msgid "Re-install %1$s %2$s from wordpress.org to restore the original file."
msgstr "Telepítsd újra a(z) %1$s %2$s csomagot a wordpress.org-ról az eredeti fájl visszaállításához."

#: includes/Rest/Presenter/FindingPresenter.php:149
msgid "No fix is available yet; consider disabling the plugin."
msgstr "Még nincs elérhető javítás; fontold meg a bővítmény kikapcsolását."

#. translators: %s: version the vulnerability is fixed in.
#: includes/Rest/Presenter/FindingPresenter.php:154
#, php-format
msgid "Update to %s."
msgstr "Frissíts erre: %s."

#: includes/Rest/Presenter/FindingPresenter.php:161
msgid "WordPress"
msgstr "WordPress"

#: includes/Rest/Presenter/FindingPresenter.php:192
msgid "checksum mismatch"
msgstr "ellenőrzőösszeg-eltérés"

#: includes/Rest/ScanController.php:118 includes/Run/Starter.php:93 includes/SiteManager/AbilityCallbacks.php:64
msgid "Unknown scan scope."
msgstr "Ismeretlen vizsgálati hatókör."

#: includes/Run/RunError.php:57
msgid "The signature set was updated while this scan was under way, so it was dropped — the next scan starts over against the new signatures."
msgstr "A szignatúrakészlet a vizsgálat közben frissült, ezért a vizsgálat megszakadt — a következő vizsgálat elölről indul az új szignatúrákkal."

#: includes/Run/RunError.php:64
msgid "Signatures could not be downloaded — check the Health tab and the backend connection."
msgstr "A szignatúrák nem tölthetők le — nézd meg az Állapotfelmérés fület és a backend-kapcsolatot."

#. translators: %s: memory_limit the tick was running at, e.g. "256 MB".
#: includes/Run/RunError.php:85
#, php-format
msgid "PHP ran out of memory during the scan (memory_limit %s). Raise memory_limit or run the scan with WP-CLI."
msgstr "A PHP memóriája elfogyott a vizsgálat közben (memory_limit %s). Emeld a memory_limit értékét, vagy futtasd a vizsgálatot WP-CLI-vel."

#: includes/Run/RunError.php:90
msgid "PHP ran out of memory during the scan. Raise memory_limit or run the scan with WP-CLI."
msgstr "A PHP memóriája elfogyott a vizsgálat közben. Emeld a memory_limit értékét, vagy futtasd a vizsgálatot WP-CLI-vel."

#: includes/Run/Scheduler.php:83
msgid "Once Weekly"
msgstr "Hetente egyszer"

#: includes/Run/Starter.php:64 includes/Run/Starter.php:153 includes/Run/Starter.php:160
msgid "A scan is already in progress."
msgstr "Már fut egy vizsgálat."

#: includes/Run/Starter.php:108
msgid "The scan path must be a directory inside the WordPress installation."
msgstr "A vizsgálati útvonalnak a WordPress telepítésen belüli könyvtárnak kell lennie."

#: includes/Run/Starter.php:156
msgid "There is no stopped scan to resume."
msgstr "Nincs folytatható, leállított vizsgálat."

#: includes/Run/Starter.php:195
msgid "The scan could not be recorded — the plugin tables are missing. Deactivate and reactivate the plugin."
msgstr "A vizsgálat nem rögzíthető — hiányoznak a bővítmény táblái. Kapcsold ki, majd újra be a bővítményt."

#: includes/SiteManager/Abilities.php:65
msgid "Run malware scans and read their findings."
msgstr "Kártevő-vizsgálatok futtatása és a találatok megtekintése."

#: includes/SiteManager/Abilities.php:103
msgid "Start Malware Scan"
msgstr "Kártevő-vizsgálat indítása"

#: includes/SiteManager/Abilities.php:104
msgid "Start a malware scan and return its run id. The scan runs in the background; poll lw-scan/status for progress."
msgstr "Kártevő-vizsgálatot indít, és visszaadja a futás azonosítóját. A vizsgálat a háttérben fut; a haladás a lw-scan/status segítségével kérdezhető le."

#: includes/SiteManager/Abilities.php:114
msgid "What to scan: the whole site, only changed files, the database, or one folder."
msgstr "Mit vizsgáljon: a teljes oldalt, csak a módosított fájlokat, az adatbázist vagy egy mappát."

#: includes/SiteManager/Abilities.php:119
msgid "Folder to scan, relative to the WordPress root. Used with scope=path."
msgstr "A vizsgálandó mappa a WordPress gyökeréhez képest. A scope=path értékkel használatos."

#: includes/SiteManager/Abilities.php:124
msgid "Continue a stopped scan instead of starting a new one."
msgstr "Leállított vizsgálat folytatása új indítása helyett."

#: includes/SiteManager/Abilities.php:148
msgid "Get Scan Status"
msgstr "Vizsgálat állapotának lekérése"

#: includes/SiteManager/Abilities.php:149
msgid "Get the progress of the running scan (or the last one), the last run summary and the current finding counts."
msgstr "A futó (vagy az utolsó) vizsgálat előrehaladásának, az utolsó futás összegzésének és az aktuális találatszámoknak a lekérése."

#: includes/SiteManager/Abilities.php:177
msgid "List Scan Findings"
msgstr "Vizsgálati találatok listázása"

#: includes/SiteManager/Abilities.php:178
msgid "List malware-scan findings, filtered by severity, type or state, one page at a time."
msgstr "Kártevő-vizsgálati találatok listázása súlyosság, típus vagy állapot szerint szűrve, oldalanként."

#: includes/SiteManager/Abilities.php:213
msgid "Only findings of this severity."
msgstr "Csak az ilyen súlyosságú találatok."

#: includes/SiteManager/Abilities.php:218
msgid "Only findings of this type."
msgstr "Csak az ilyen típusú találatok."

#: includes/SiteManager/Abilities.php:223
msgid "Only findings in this state."
msgstr "Csak az ilyen állapotú találatok."

#: includes/SiteManager/Abilities.php:228
msgid "1-based page number."
msgstr "1-től számozott oldalszám."

#: includes/SiteManager/Abilities.php:234
msgid "Findings per page. Defaults to 50, max 200."
msgstr "Találatok oldalanként. Alapértelmezett: 50, max. 200."

#: includes/SiteManager/Abilities.php:250
msgid "Set Finding State"
msgstr "Találat állapotának beállítása"

#: includes/SiteManager/Abilities.php:251
msgid "Mark findings as acknowledged or ignored, or move them back to new. Never changes a file or the database."
msgstr "Találatok megjelölése nyugtázottként vagy mellőzöttként, illetve visszaállításuk újra. Soha nem módosít fájlt vagy adatbázist."

#: includes/SiteManager/Abilities.php:261
msgid "Finding ids to update."
msgstr "Frissítendő találatazonosítók."

#: includes/SiteManager/Abilities.php:266
msgid "The state to set."
msgstr "A beállítandó állapot."

