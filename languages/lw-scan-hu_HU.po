#: build/index.js:23
msgid "Manually (Health tab)"
msgstr "Kézzel (Állapotfelmérés fül)"

#: build/index.js:23
msgid "Scan depth"
msgstr "Vizsgálat mélysége"

#: build/index.js:23
msgid "Token-level analysis of unknown PHP files: input to dangerous call pairs, identifier entropy, static decoding, disguise headers. Adds \"review\" findings only, never \"alert\" on its own."
msgstr "Ismeretlen PHP-fájlok token-szintű elemzése: bemenet veszélyes hívásokba, azonosítók entrópiája, statikus dekódolás, álcázó fejlécek. Csak „átnézendő” találatot ad, önmagában soha nem „riasztás”-t."

#: build/index.js:23
msgid "Per-file size limit"
msgstr "Fájlonkénti méretkorlát"

#: build/index.js:23
msgid "Larger files get type detection and hash matching only. A large PHP file skipped this way is listed as \"review\"."
msgstr "A nagyobb fájloknál csak típusfelismerés és hash-egyezés történik. Az így kihagyott nagy PHP-fájl „átnézendő” találatként jelenik meg."

#: build/index.js:23
msgid "Excluded paths"
msgstr "Kizárt útvonalak"

#: build/index.js:23
msgid "One pattern per line, relative to the WordPress root. * matches any characters. wp-content/lw-scan is always excluded."
msgstr "Soronként egy minta, a WordPress gyökeréhez képest. A * bármilyen karakterre illeszkedik. A wp-content/lw-scan mindig ki van zárva."

#: build/index.js:23
msgid "Follow symlinks"
msgstr "Symlinkek követése"

#: build/index.js:23
msgid "Off is safer: symlinked directories outside the site are not scanned."
msgstr "Kikapcsolva biztonságosabb: az oldalon kívülre mutató symlinkelt könyvtárakat nem vizsgálja."

#: build/index.js:23
msgid "Follow symlinked directories"
msgstr "Symlinkelt könyvtárak követése"

#: build/index.js:23
msgid "Settings affect scanning and notifications only. Nothing here modifies files or database rows."
msgstr "A beállítások csak a vizsgálatot és az értesítéseket érintik. Semmi nem módosít fájlt vagy adatbázissort."

#: build/index.js:23
msgid "Scanning is enabled. Nothing needs your attention here."
msgstr "A vizsgálat engedélyezve van. Itt nincs teendőd."

#. translators: 1: number of rules, 2: when the bundle was checked.
#: build/index.js:24
msgid "%1$s rules · checked %2$s"
msgstr "%1$s szabály · ellenőrizve: %2$s"

#: build/index.js:24
msgid "Checksums cached"
msgstr "Ellenőrzőösszegek gyorsítótárazva"

#: build/index.js:24
msgid "wordpress.org package checksums"
msgstr "wordpress.org csomag-ellenőrzőösszegek"

#: build/index.js:24
msgid "Vulnerability data"
msgstr "Sérülékenységi adatok"

#: build/index.js:24
msgid "lookups cached · 24 h"
msgstr "lekérdezések gyorsítótárazva · 24 óra"

#: build/index.js:24
msgid "Checks"
msgstr "Ellenőrzések"

#: build/index.js:24
msgid "Run scans from a system cron"
msgstr "Vizsgálatok futtatása rendszer cronból"

#: build/index.js:24
msgid "Recommended fix for the warning"
msgstr "Ajánlott javítás a figyelmeztetéshez"

#: build/index.js:24
msgid "Run the scan from a system cron so it does not depend on site traffic. Paste one of these into the server's crontab:"
msgstr "Futtasd a vizsgálatot rendszer cronból, hogy ne függjön az oldal forgalmától. Másold be az egyiket a szerver crontabjába:"

#: build/index.js:24
msgid "Status endpoint"
msgstr "Status endpoint"

#: build/index.js:24
msgid "A read-only report on this site's malware-scan status for an external monitoring service. It only reads; it changes nothing. Enabled by default."
msgstr "Csak olvasható jelentés az oldal kártevő-vizsgálati állapotáról egy külső monitorozó szolgáltatásnak. Csak olvas, semmit nem módosít. Alapból engedélyezve."

#: build/index.js:24
msgid "Endpoint"
msgstr "Endpoint"

#: build/index.js:24
msgid "Access"
msgstr "Hozzáférés"

#: build/index.js:24
msgid "Give this address to your monitoring service."
msgstr "Add meg ezt a címet a monitorozó szolgáltatásodnak."

#: build/index.js:24
msgid "Status URL"
msgstr "Status URL"

#: build/index.js:24
msgid "The key inside it is the only protection — anyone who knows the address can read the report."
msgstr "A benne lévő kulcs az egyetlen védelem — bárki, aki ismeri a címet, elolvashatja a jelentést."

#: build/index.js:24
msgid "The endpoint is switched off: this address answers \"not found\" until you switch it on and save."
msgstr "Az endpoint ki van kapcsolva: ez a cím „not found” választ ad, amíg be nem kapcsolod és el nem mented."

#. translators: %s: date and time the URL was created.
#: build/index.js:25
msgid "Created: %s"
msgstr "Létrehozva: %s"

#: build/index.js:25 build/index.js:26
msgid "Generate new URL"
msgstr "Új URL generálása"

#: build/index.js:25
msgid "Reuse the result for"
msgstr "Eredmény újrahasználása ennyi ideig"

#: build/index.js:25
msgid "A stored result answers requests for this long; after that the next request runs the check again."
msgstr "A tárolt eredmény ennyi ideig szolgálja ki a kéréseket; utána a következő kérés újrafuttatja az ellenőrzést."

#. translators: %d: number of minutes.
#: build/index.js:26
msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d perc"
msgstr[1] "%d perc"

#: build/index.js:26
msgid "New URL generated. The previous URL no longer works."
msgstr "Új URL generálva. Az előző URL már nem működik."

#: build/index.js:26
msgid "The current URL stops working immediately. Continue?"
msgstr "A jelenlegi URL azonnal megszűnik működni. Folytatod?"

#. translators: %s: plugin, theme or WordPress name and installed version.
#: includes/Notify/VulnLine.php:44
#, php-format
msgid "%s: known vulnerability, no fixed version yet"
msgstr "%s: ismert sebezhetőség, javított verzió még nincs"

#. translators: 1: plugin, theme or WordPress name and installed version. 2: version that fixes it.
#: includes/Notify/VulnLine.php:51
#, php-format
msgid "%1$s: known vulnerability, update to %2$s"
msgstr "%1$s: ismert sebezhetőség, frissíts erre: %2$s"

#: includes/Notify/Mailer.php:170
msgid "Details and sources are on the Findings tab:"
msgstr "A részletek és a források a Találatok fülön:"
